# Edit these, then every script picks them up.
export ADMIN_PROFILE="default"           # your admin profile for the sandbox account
export AWS_REGION="ap-south-1"           # region where you'll create the demo buckets
export PREFIX="aiviskar-vansh"           # bucket name prefix; must be globally unique (lowercase, no spaces)

# Usually no need to change these
export AGENT_ROLE="aws-buddy-agent"
export AGENT_PROFILE="buddy"
